# Copy to .env.local for local work. On Vercel, set these under
# Project > Settings > Environment Variables. Never commit real values.

# Required for the live chat. Without it the chat runs in demo mode.
# Create a key at https://console.anthropic.com/ and set a monthly spend limit there.
ANTHROPIC_API_KEY=

# Optional. Model for the planner and the writer, and for the dynamic agents.
# AGENT_MODEL=claude-opus-5-5
# WORKER_MODEL=claude-haiku-5-5

# Optional. Chat limits.
# CHAT_VISITOR_LIMIT=8     # questions per visitor per 10 minutes
# CHAT_DAILY_LIMIT=200     # questions per day for the whole site

# Optional. Durable memory (rate limits, learned routes, knowledge gaps).
# Added automatically when you connect Upstash Redis in Vercel > Storage.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
